{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MongLong0214/agent-operator-score/contracts/schemas/aos-interpretation-use-argument.v1.schema.json",
  "title": "AOS interpretation and use argument",
  "description": "The four inferences a number has to survive before it may be read as anything, each with its assumptions, its evidence, the rebuttals against it, and the stage it stops at.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "contract_version", "claim_stages", "default_claim_stage", "maximum_claim_stage",
    "generalizability_status", "standard_setting", "categories", "cut_scores", "legacy_band_surface",
    "intended_uses", "forbidden_uses", "comparability_rules", "inferences", "validation_registry", "release_note"
  ],
  "properties": {
    "schema": { "const": "aos-interpretation-use-argument.v1" },
    "contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "claim_stages": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/stage" } },
    "default_claim_stage": { "enum": ["RUN_DIAGNOSTIC", "PROFILE_BOUND", "GENERALIZABILITY_SUPPORTED"] },
    "maximum_claim_stage": { "enum": ["RUN_DIAGNOSTIC", "PROFILE_BOUND", "GENERALIZABILITY_SUPPORTED"] },
    "generalizability_status": { "enum": ["UNESTABLISHED", "SUPPORTED"] },
    "standard_setting": { "type": "null" },
    "categories": { "type": "null" },
    "cut_scores": { "type": "null" },
    "legacy_band_surface": {
      "description": "The ability category the rest of the product still emits, and which modules carry it. This contract issues none; asserting that as a property of the product rather than of the contract was false, so the artifact discloses the surface instead.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "modules", "owner_issue", "statement"],
      "properties": {
        "status": { "enum": ["PRESENT", "REMOVED"] },
        "modules": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
        "owner_issue": { "type": "integer", "minimum": 1 },
        "statement": { "type": "string", "minLength": 20 }
      }
    },
    "intended_uses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 5 } },
    "forbidden_uses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 5 } },
    "comparability_rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/comparability" } },
    "inferences": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/inference" } },
    "validation_registry": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/registry_entry" } },
    "release_note": { "type": "string", "minLength": 20 }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "definition", "permits", "forbids"],
      "properties": {
        "stage_id": { "enum": ["RUN_DIAGNOSTIC", "PROFILE_BOUND", "GENERALIZABILITY_SUPPORTED"] },
        "definition": { "type": "string", "minLength": 20 },
        "permits": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
        "forbids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } }
      }
    },
    "comparability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "facets", "statement", "status"],
      "properties": {
        "rule_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "facets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
        "statement": { "type": "string", "minLength": 20 },
        "status": { "enum": ["UNESTABLISHED", "ENFORCED"] }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inference_id", "order", "claim", "assumptions", "evidence", "rebuttals", "status", "maximum_claim_stage_if_supported"],
      "properties": {
        "inference_id": { "enum": ["scoring", "within_cycle_generalization", "extrapolation", "use"] },
        "order": { "type": "integer", "minimum": 1, "maximum": 4 },
        "claim": { "type": "string", "minLength": 20 },
        "assumptions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 10 } },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "rebuttals": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rebuttal" } },
        "status": { "enum": ["SUPPORTED", "PARTIALLY_SUPPORTED", "UNSUPPORTED", "SUPPORTED_FOR_LOCAL_SELF_DIAGNOSIS_ONLY"] },
        "maximum_claim_stage_if_supported": { "enum": ["RUN_DIAGNOSTIC", "PROFILE_BOUND", "GENERALIZABILITY_SUPPORTED"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "status", "detail"],
      "properties": {
        "evidence_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "status": { "enum": ["PASS", "FAIL", "UNESTABLISHED"] },
        "detail": { "type": "string", "minLength": 20 }
      }
    },
    "rebuttal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rebuttal_id", "status", "detail"],
      "properties": {
        "rebuttal_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "status": { "enum": ["OPEN", "PARTIALLY_MITIGATED", "MITIGATED"] },
        "detail": { "type": "string", "minLength": 10 }
      }
    },
    "registry_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "status", "detail"],
      "properties": {
        "category": { "enum": ["content", "response_process", "internal_structure", "relations_to_other_variables", "generalizability", "fairness_invariance", "consequences"] },
        "status": { "enum": ["PASS", "FAIL", "UNESTABLISHED"] },
        "detail": { "type": "string", "minLength": 10 }
      }
    }
  }
}
