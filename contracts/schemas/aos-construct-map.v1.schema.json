{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MongLong0214/agent-operator-score/contracts/schemas/aos-construct-map.v1.schema.json",
  "title": "AOS construct map",
  "description": "The constructs AOS claims to measure, which cells stand for each of them on which axis, and the one index that may be computed from them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_version",
    "process_index",
    "outcome_domains",
    "longitudinal_lane",
    "constructs"
  ],
  "properties": {
    "schema": {
      "const": "aos-construct-map.v1"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "process_index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "interpretation",
        "axis",
        "construct_ids",
        "aggregation",
        "issued_only_when",
        "category",
        "cut_scores",
        "percentile",
        "rank"
      ],
      "properties": {
        "label": {
          "const": "PROFILE-BOUND OPERATOR PROCESS INDEX"
        },
        "interpretation": {
          "const": "descriptive only"
        },
        "axis": {
          "const": "operator_process"
        },
        "construct_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^C[1-7]$"
          }
        },
        "aggregation": {
          "type": "string",
          "minLength": 10
        },
        "issued_only_when": {
          "type": "string",
          "minLength": 10
        },
        "category": {
          "type": "null"
        },
        "cut_scores": {
          "type": "null"
        },
        "percentile": {
          "type": "null"
        },
        "rank": {
          "type": "null"
        }
      }
    },
    "outcome_domains": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregation",
        "issued_only_when",
        "note",
        "domains"
      ],
      "properties": {
        "aggregation": {
          "type": "string",
          "minLength": 10
        },
        "issued_only_when": {
          "type": "string",
          "minLength": 10
        },
        "note": {
          "type": "string",
          "minLength": 10
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "domain_id",
              "title",
              "cell_ids"
            ],
            "properties": {
              "domain_id": {
                "type": "string",
                "pattern": "^O[0-9]+$"
              },
              "title": {
                "type": "string",
                "minLength": 3,
                "maxLength": 200
              },
              "cell_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^C[1-7]\\.[A-Z]{2}\\.[0-9]{2}$"
                }
              }
            }
          }
        }
      }
    },
    "longitudinal_lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "construct_ids",
        "note"
      ],
      "properties": {
        "construct_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^C[1-7]$"
          }
        },
        "note": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "constructs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/construct"
      }
    }
  },
  "$defs": {
    "construct": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "construct_id",
        "title",
        "definition",
        "in_process_index",
        "axes"
      ],
      "properties": {
        "construct_id": {
          "type": "string",
          "pattern": "^C[1-7]$"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "definition": {
          "type": "string",
          "minLength": 20
        },
        "in_process_index": {
          "type": "boolean"
        },
        "axes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/axis_group"
          }
        }
      }
    },
    "axis_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_cell_ids",
        "optional_cell_ids"
      ],
      "properties": {
        "required_cell_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^C[1-7]\\.[A-Z]{2}\\.[0-9]{2}$"
          }
        },
        "optional_cell_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^C[1-7]\\.[A-Z]{2}\\.[0-9]{2}$"
          }
        }
      }
    }
  }
}
