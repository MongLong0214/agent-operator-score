{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MongLong0214/agent-operator-score/contracts/schemas/aos-task-model.v1.schema.json",
  "title": "AOS task model",
  "description": "What each administered form creates an opportunity for, what perturbation and oracle it must carry, and which opportunity sources are declared but not administered.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_version", "form_classes", "equivalence", "exposure_ledger", "form_variation", "forms", "unadministered_opportunity_sources"],
  "properties": {
    "schema": { "const": "aos-task-model.v1" },
    "contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "form_classes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/form_class" } },
    "equivalence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "statement"],
      "properties": {
        "status": { "enum": ["UNESTABLISHED", "ESTABLISHED"] },
        "statement": { "type": "string", "minLength": 20 }
      }
    },
    "exposure_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "statement"],
      "properties": {
        "required": { "type": "boolean" },
        "statement": { "type": "string", "minLength": 20 }
      }
    },
    "form_variation": { "$ref": "#/$defs/form_variation" },
    "forms": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/form" } },
    "unadministered_opportunity_sources": { "type": "array", "items": { "$ref": "#/$defs/source" } }
  },
  "$defs": {
    "form_class": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class_id", "definition"],
      "properties": {
        "class_id": { "enum": ["WARMUP", "PRACTICE", "OPERATIONAL", "TRANSFER"] },
        "definition": { "type": "string", "minLength": 20 }
      }
    },
    "form_variation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id", "contract_version", "sample_size", "minimum_unique_task_forms",
        "maximum_cosmetic_only_differences", "meaningful_variation_required_family_ids",
        "task_oracle_evidence_binding_required_family_ids", "fixed_assessment_identities",
        "historical_axis_accounting"
      ],
      "properties": {
        "schema_id": { "const": "aos-form-variation-contract.v2" },
        "contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "sample_size": { "type": "integer", "minimum": 1 },
        "minimum_unique_task_forms": { "type": "integer", "minimum": 2 },
        "maximum_cosmetic_only_differences": { "type": "integer", "minimum": 0 },
        "meaningful_variation_required_family_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "task_oracle_evidence_binding_required_family_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "fixed_assessment_identities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["family_id", "assessment_identity"],
            "properties": {
              "family_id": { "type": "string", "minLength": 1 },
              "assessment_identity": { "type": "string", "minLength": 1 }
            }
          }
        },
        "historical_axis_accounting": {
          "type": "object",
          "additionalProperties": false,
          "required": ["basis", "implemented_decision_axis_count", "declared_decision_axis_count", "fam5_unimplemented_decision_axis_count"],
          "properties": {
            "basis": { "type": "string", "minLength": 10 },
            "implemented_decision_axis_count": { "type": "integer", "minimum": 0 },
            "declared_decision_axis_count": { "type": "integer", "minimum": 0 },
            "fam5_unimplemented_decision_axis_count": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "form_id", "family", "title", "class", "administered_metric_ids", "scored_once_per_cycle",
        "construct_opportunity_cell_ids", "shared_opportunity_cell_ids",
        "required_cell_ids", "optional_cell_ids",
        "required_perturbation", "required_oracle", "facets", "shortcut_prohibitions", "declared_opportunity_count"
      ],
      "properties": {
        "form_id": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 5 },
        "class": { "enum": ["WARMUP", "PRACTICE", "OPERATIONAL", "TRANSFER"] },
        "administered_metric_ids": {
          "description": "The metrics lib/observe.mjs attributes to this family. Every metric belongs to exactly one form, which is what makes subcheck-to-form ownership a partition rather than an approximation.",
          "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^M[0-9]{2}$" }
        },
        "scored_once_per_cycle": { "type": "boolean" },
        "construct_opportunity_cell_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^C[1-7]\\.[A-Z]{2}\\.[0-9]{2}$" } },
        "shared_opportunity_cell_ids": {
          "description": "The cells this form administers that another form also administers. Declared so that the six counts are not read as a partition of the eighty subchecks: they sum to eighty-four.",
          "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^C[1-7]\\.[A-Z]{2}\\.[0-9]{2}$" }
        },
        "required_cell_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^C[1-7]\\.[A-Z]{2}\\.[0-9]{2}$" } },
        "optional_cell_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^C[1-7]\\.[A-Z]{2}\\.[0-9]{2}$" } },
        "required_perturbation": { "type": "string", "minLength": 10 },
        "required_oracle": { "type": "string", "minLength": 10 },
        "facets": { "$ref": "#/$defs/form_facets" },
        "shortcut_prohibitions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
        "declared_opportunity_count": {
          "description": "The subchecks the cells this form administers declare, summed. Derived and compared by checkEcdContract rather than believed; it is not a minimum and was misnamed as one.",
          "type": "integer", "minimum": 1
        }
      }
    },
    "form_facets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "domain", "difficulty", "language", "interface"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 3 },
        "difficulty": { "$ref": "#/$defs/facet_value" },
        "language": { "$ref": "#/$defs/facet_value" },
        "interface": { "$ref": "#/$defs/facet_value" }
      }
    },
    "facet_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "status", "note"],
      "properties": {
        "value": { "type": ["string", "null"], "minLength": 1 },
        "status": { "enum": ["DECLARED", "UNESTABLISHED"] },
        "note": { "type": "string", "minLength": 10 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "required_for_cell_ids", "statement", "status"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "required_for_cell_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^C[1-7]\\.[A-Z]{2}\\.[0-9]{2}$" } },
        "statement": { "type": "string", "minLength": 20 },
        "status": { "enum": ["NOT_ADMINISTERED", "ADMINISTERED"] }
      }
    }
  }
}
