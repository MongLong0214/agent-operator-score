{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MongLong0214/agent-operator-score/contracts/schemas/aos-observable-cell.v1.schema.json",
  "title": "AOS observable cell registry",
  "description": "Every scored cell in the AOS evidence-centred design, and everything a cell has to say before anything may be scored into it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_version", "declared_subcheck_count", "cells"],
  "properties": {
    "schema": { "const": "aos-observable-cell.v1" },
    "contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "declared_subcheck_count": {
      "description": "How many distinct fully qualified subchecks this contract claims to map. Pinned rather than inferred: a subcheck name duplicated inside one metric leaves the inferred count unchanged and the distinct count one lower, and every mapping check below is written over the distinct set.",
      "type": "integer", "minimum": 1
    },
    "cells": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cell" } }
  },
  "$defs": {
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id", "construct_id", "axis", "title", "claim", "deferred_claim", "observable",
        "task_opportunity", "authority", "rival_explanations", "minimum_opportunities",
        "minimum_opportunities_basis", "minimum_opportunities_source",
        "scoring_rule_id", "missing_policy", "facet_identity", "subcheck_ids", "subcheck_administered_by",
        "required_for_construct", "credit_bearing", "population_status"
      ],
      "properties": {
        "cell_id": { "type": "string", "pattern": "^C[1-7]\\.[A-Z]{2}\\.[0-9]{2}$" },
        "construct_id": { "type": "string", "pattern": "^C[1-7]$" },
        "axis": { "enum": ["operator_process", "reliance_calibration", "system_outcome", "delegated_artifact"] },
        "title": { "type": "string", "minLength": 3 },
        "claim": { "type": "string", "minLength": 20 },
        "deferred_claim": {
          "description": "The part of the intended claim this cell's authority cannot observe, or null. A cell that names one may not be scored: a partly observable claim scored as a whole one reports something nobody saw.",
          "type": ["string", "null"], "minLength": 20
        },
        "observable": { "type": "string", "minLength": 20 },
        "task_opportunity": { "$ref": "#/$defs/task_opportunity" },
        "authority": { "type": "string", "minLength": 3 },
        "rival_explanations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/rival" } },
        "minimum_opportunities": { "type": ["integer", "null"], "minimum": 1 },
        "minimum_opportunities_basis": { "enum": ["DECLARED_COVERAGE", "CONTRACT_SPECIFIED", "UNESTABLISHED"] },
        "minimum_opportunities_source": {
          "description": "The evidence-model clause that fixed a CONTRACT_SPECIFIED minimum, and null for every other basis. Without it a decided number is indistinguishable from a measured one.",
          "type": ["string", "null"], "minLength": 3
        },
        "scoring_rule_id": { "type": "string", "minLength": 3 },
        "missing_policy": { "enum": ["NOT_OBSERVED", "INSUFFICIENT_OPPORTUNITIES", "WITHHELD"] },
        "facet_identity": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "subcheck_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^M[0-9]{2}\\.[a-z0-9-]+$" } },
        "subcheck_administered_by": {
          "description": "Which single form administers each of this cell's subchecks. Form ownership sits on the subcheck and not on the cell, because a cell can hold subchecks from two metrics that two different families produce; keyed on the cell, the per-form counts stop partitioning the product.",
          "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/subcheck_administration" }
        },
        "required_for_construct": { "type": "boolean" },
        "credit_bearing": { "type": "boolean" },
        "population_status": { "enum": ["SUBCHECK_BACKED", "DECLARED_UNPOPULATED"] }
      }
    },
    "subcheck_administration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subcheck_id", "form_id"],
      "properties": {
        "subcheck_id": { "type": "string", "pattern": "^M[0-9]{2}\\.[a-z0-9-]+$" },
        "form_id": { "type": "string", "minLength": 1 }
      }
    },
    "task_opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["form_ids", "task_features", "shortcut_prohibitions"],
      "properties": {
        "form_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "task_features": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "shortcut_prohibitions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "rival": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "status", "mitigation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "statement": { "type": "string", "minLength": 20 },
        "status": { "enum": ["OPEN", "PARTIALLY_MITIGATED", "CONTROLLED"] },
        "mitigation": { "type": "string", "minLength": 4 }
      }
    }
  }
}
