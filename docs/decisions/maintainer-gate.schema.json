{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOS Pre-Implementation Gate Administration Registry v2",
  "type": "object",
  "required": ["version", "status", "batches", "invalidation"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 2 },
    "status": { "enum": ["PENDING", "PARTIAL", "ACCEPTED", "REJECTED", "INVALIDATED"] },
    "batches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "scope",
          "target",
          "required_artifacts",
          "required_transitions",
          "artifacts",
          "transitions",
          "events"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "status": { "enum": ["PENDING", "ACCEPTED", "REJECTED", "INVALIDATED"] },
          "scope": { "type": "string", "minLength": 1 },
          "target": {
            "type": "object",
            "required": ["repository", "branch"],
            "additionalProperties": false,
            "properties": {
              "repository": { "const": "github.com/MongLong0214/agent-operator-score" },
              "branch": { "const": "dev" },
              "reviewed_head": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
            }
          },
          "required_artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "kind"],
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
                "kind": { "enum": ["ADR", "PRD", "TICKET"] }
              }
            }
          },
          "required_transitions": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["ADR_ACCEPTED", "PRD_ACCEPTED", "TICKET_READY_FOR_RED"] }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "sha256", "kind"],
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "kind": { "enum": ["ADR", "PRD", "TICKET"] }
              }
            }
          },
          "transitions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "artifact_paths"],
              "additionalProperties": false,
              "properties": {
                "type": { "enum": ["ADR_ACCEPTED", "PRD_ACCEPTED", "TICKET_READY_FOR_RED"] },
                "artifact_paths": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" }
                }
              }
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["from", "to", "recorded_at", "recorded_by"],
              "additionalProperties": false,
              "properties": {
                "from": { "enum": ["PENDING", "ACCEPTED"] },
                "to": { "enum": ["ACCEPTED", "REJECTED", "INVALIDATED"] },
                "recorded_at": { "type": "string", "format": "date-time" },
                "recorded_by": { "type": "string", "minLength": 1 }
              }
            }
          },
          "preparation": {
            "type": "object",
            "required": ["prepared_by"],
            "additionalProperties": false,
            "properties": {
              "prepared_by": { "type": "string", "minLength": 1 }
            }
          },
          "approval": {
            "type": "object",
            "required": ["approved_by", "approved_at", "role"],
            "additionalProperties": false,
            "properties": {
              "approved_by": { "type": "string", "minLength": 1 },
              "approved_at": { "type": "string", "format": "date-time" },
              "role": { "const": "MAINTAINER" }
            }
          },
          "invalidation": {
            "type": "object",
            "required": ["invalidated_at", "invalidated_by", "reason"],
            "additionalProperties": false,
            "properties": {
              "invalidated_at": { "type": "string", "format": "date-time" },
              "invalidated_by": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "invalidation": {
      "type": "object",
      "required": ["on_artifact_or_reviewed_head_change", "effect"],
      "additionalProperties": false,
      "properties": {
        "on_artifact_or_reviewed_head_change": { "const": true },
        "effect": { "const": "invalidate_affected_batch_and_require_fresh_pending_batch" }
      }
    }
  }
}
