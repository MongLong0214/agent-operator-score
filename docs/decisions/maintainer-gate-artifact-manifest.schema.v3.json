{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOS Maintainer Gate Artifact Manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "artifacts"],
  "properties": {
    "schema_version": { "const": 3 },
    "manifest_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "kind",
          "source_record_id",
          "source_record_sha256",
          "migration_provenance"
        ],
        "properties": {
          "path": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "kind": { "enum": ["ADR", "PRD", "TICKET"] },
          "source_record_id": { "type": "string", "minLength": 1 },
          "source_record_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "migration_provenance": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
