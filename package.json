{
  "name": "agent-operator-score",
  "version": "0.1.17",
  "private": true,
  "description": "Local assessment instrument for Agent Operator Score. Runs from a clone or a locally built tarball; no public package is published.",
  "type": "module",
  "engines": {
    "node": ">=22.18 <25"
  },
  "devDependencies": {
    "acorn": "8.18.0"
  },
  "scripts": {
    "test": "node --test",
    "test:mutation": "node tests/mutation/run.mjs",
    "verify:mvp": "node bin/aos.mjs verify",
    "smoke:package": "node tests/package-smoke.mjs",
    "verify:review-holdout-floor": "node --test tests/product/review-holdout-floor.test.mjs",
    "verify:known-incident-corpus": "node --test tests/product/known-incident-corpus.test.mjs",
    "verify:no-raw-holdout-data": "node --test tests/product/no-raw-holdout-data.test.mjs",
    "verify:ecd-contract": "node --test tests/product/ecd-construct-map.test.mjs tests/product/ecd-evidence-model.test.mjs tests/product/ecd-task-model.test.mjs tests/product/ecd-interpretation-use.test.mjs tests/product/ecd-aggregation.test.mjs tests/product/ecd-shortcuts.test.mjs",
    "verify:execution-plan": "node scripts/verify-v020-execution-plan.mjs",
    "verify:execution-plan:live": "node scripts/verify-v020-execution-plan.mjs --live --json",
    "verify:action-pins": "node scripts/verify-action-pins.mjs",
    "verify:isolation-feasibility": "node --test tests/product/confinement-probe.test.mjs",
    "verify:isolation-boundary": "node --test tests/product/confinement.test.mjs",
    "verify:official-issuance-gate": "node --test tests/product/confinement.test.mjs tests/product/official-issuance.test.mjs tests/product/confinement-real-lane.test.mjs",
    "verify:real-runtime-strict": "AOS_REAL_STRICT_REQUIRED=1 node --test tests/product/confinement-real-lane.test.mjs",
    "verify:model-identity": "node --test tests/product/model-identity.test.mjs tests/product/model-canary.test.mjs tests/product/profile.test.mjs tests/product/cycle-command.test.mjs tests/product/dashboard.test.mjs",
    "verify:profile-aggregation": "node --test tests/product/profile-aggregation.test.mjs",
    "verify:process-outcome-counterfactual": "node --test tests/product/process-outcome-counterfactual.test.mjs",
    "verify:projection-consistency": "node --test tests/product/projection-consistency.test.mjs",
    "verify:actual-effect-observation": "node --test tests/product/effect-events.test.mjs tests/product/actual-effect-authority.test.mjs tests/product/m19-declarations.test.mjs",
    "verify:effect-attacks": "node --test tests/product/effect-attack-lane.test.mjs tests/product/effect-events.test.mjs",
    "verify:no-operator-score-hero": "node --test tests/product/no-operator-score-hero.test.mjs",
    "verify:operator-event-authority": "node --test tests/product/operator-event-authority.test.mjs",
    "verify:no-agent-artifact-process-credit": "node --test tests/product/no-agent-artifact-process-credit.test.mjs",
    "verify:initial-before-advice-interface": "node --test tests/product/initial-before-advice.test.mjs",
    "verify:initial-before-advice": "node --test tests/product/reliance.test.mjs",
    "verify:agent-relay-protocol": "node --test tests/product/agent-relay-protocol.test.mjs",
    "verify:initial-before-advice-relay": "node --test --test-name-pattern='initial user judgment' tests/product/agent-relay-protocol.test.mjs",
    "verify:no-terminal-input": "node --test --test-name-pattern='shipped binary honestly' tests/product/agent-relay-protocol.test.mjs",
    "verify:agent-autonomous-refusal": "node --test --test-name-pattern='autonomous, bundled' tests/product/agent-relay-protocol.test.mjs",
    "verify:relay-atomicity": "node --test --test-name-pattern='crash after accepting|durable receipt even after expiry' tests/product/agent-relay-protocol.test.mjs",
    "verify:CAIR-CSR": "node --test --test-name-pattern='CAIR|CSR|initial state' tests/product/reliance.test.mjs",
    "verify:over-under-separation": "node --test --test-name-pattern='over/under' tests/product/reliance.test.mjs",
    "verify:delegation-vs-adoption": "node --test --test-name-pattern='delegation|acceptance rate' tests/product/reliance.test.mjs",
    "verify:choice-independence": "node --test --test-name-pattern='choice|unrelated prior' tests/product/reliance.test.mjs",
    "verify:confidence-calibration": "node --test --test-name-pattern='calibration|confidence' tests/product/reliance.test.mjs",
    "verify:no-reliance-rate-shortcut": "node --test --test-name-pattern='low denominators|operational floor|acceptance rate' tests/product/reliance.test.mjs",
    "verify:operator-event-projection": "node --test tests/product/operator-event-projection.test.mjs",
    "verify:operator-channel-authority": "node --test tests/product/operator-channel-authority.test.mjs",
    "verify:routing-requirements": "node --test tests/product/routing-requirements.test.mjs",
    "verify:minimal-route-oracle": "node --test tests/product/minimal-route-oracle.test.mjs",
    "verify:actual-route-authority": "node --test tests/product/actual-route-authority.test.mjs",
    "verify:routing-counterfactual": "node --test tests/product/routing-counterfactual.test.mjs",
    "verify:routing-cli-authority": "node --test tests/product/routing-cli-authority.test.mjs",
    "verify:routing-requirement-authority": "node --test tests/product/routing-requirement-authority.test.mjs",
    "verify:branch-audit": "node --test tests/product/stale-branch-audit.test.mjs",
    "verify:branch-cleanup-invariants": "node --test tests/product/branch-cleanup-invariants.test.mjs",
    "verify:no-open-pr-head-deletion": "node --test tests/product/no-open-pr-head-deletion.test.mjs",
    "check:defect-classes": "node scripts/check-defect-classes.mjs",
    "verify:agent-discovery-fixture": "node --test tests/product/discovery-canary.test.mjs",
    "verify:agent-discovery-local": "AOS_DISCOVERY_LOCAL_REQUIRED=1 node --test tests/product/discovery-canary.test.mjs",
    "verify:official-support-selection": "node --test tests/product/discovery-official-support.test.mjs",
    "verify:zero-setup-discovery": "node --test tests/product/discovery-zero-setup.test.mjs tests/product/discovery.test.mjs"
  },
  "bin": {
    "aos": "./bin/aos.mjs"
  },
  "files": [
    "bin/",
    "contracts/",
    "lib/",
    "fixtures/known-incidents/",
    "fixtures/scoring/",
    "docs/",
    "governance/",
    "schemas/",
    "reliance-events/",
    "scripts/",
    "fixtures/execution-plan/",
    "fixtures/confinement/",
    "README.md",
    "README.ko.md",
    "README.ja.md",
    "README.zh-CN.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "fixtures/attacks/"
  ],
  "os": [
    "darwin",
    "linux"
  ]
}
