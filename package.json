{
  "name": "agent-operator-score",
  "version": "0.1.17",
  "private": true,
  "description": "Local assessment instrument for Agent Operator Score. Runs from a clone or a locally built tarball; no public package is published.",
  "type": "module",
  "engines": {
    "node": ">=22.18 <25"
  },
  "scripts": {
    "test": "node --test",
    "test:mutation": "node tests/mutation/run.mjs",
    "verify:mvp": "node bin/aos.mjs verify",
    "smoke:package": "node tests/package-smoke.mjs",
    "verify:review-holdout-floor": "node --test tests/product/review-holdout-floor.test.mjs",
    "verify:known-incident-corpus": "node --test tests/product/known-incident-corpus.test.mjs",
    "verify:no-raw-holdout-data": "node --test tests/product/no-raw-holdout-data.test.mjs",
    "verify:execution-plan": "node scripts/verify-v020-execution-plan.mjs",
    "verify:execution-plan:live": "node scripts/verify-v020-execution-plan.mjs --live --json"
  },
  "bin": {
    "aos": "./bin/aos.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "fixtures/known-incidents/",
    "docs/",
    "governance/",
    "schemas/",
    "scripts/",
    "README.md",
    "README.ko.md",
    "README.ja.md",
    "README.zh-CN.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "os": [
    "darwin",
    "linux"
  ]
}
