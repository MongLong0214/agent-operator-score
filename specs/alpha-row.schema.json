{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentoperatorscore.dev/schemas/alpha-row.schema.json",
  "title": "Alpha preregistration row",
  "description": "Pseudonymous row for the preregistered n=20 feasibility alpha.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "participant_id",
    "consent_recorded",
    "cohort",
    "form",
    "enrollment_status",
    "exclusion_reason",
    "reference_run_id",
    "task_id",
    "session_id",
    "reviewer_a",
    "reviewer_b",
    "review_adjudication",
    "duration_minutes",
    "automated_score",
    "expert_review",
    "missing_reason",
    "deviation_id",
    "transfer_outcome"
  ],
  "properties": {
    "participant_id": {
      "type": "string",
      "description": "Pseudonymous enrollment identifier."
    },
    "consent_recorded": {
      "type": "boolean"
    },
    "cohort": {
      "type": "string",
      "enum": ["novice", "intermediate", "expert"]
    },
    "form": {
      "type": "string",
      "enum": ["A", "B"]
    },
    "enrollment_status": {
      "type": "string",
      "enum": ["enrolled", "excluded", "withdrawn", "completed"]
    },
    "exclusion_reason": {
      "type": ["string", "null"],
      "enum": ["NO_CONSENT", "INELIGIBLE", "PRE_ASSESSMENT_WITHDRAWAL", null]
    },
    "reference_run_id": {
      "type": ["string", "null"]
    },
    "task_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "reviewer_a": {
      "type": ["string", "null"],
      "description": "Pseudonymous first blinded-reviewer identifier."
    },
    "reviewer_b": {
      "type": ["string", "null"],
      "description": "Pseudonymous second blinded-reviewer identifier."
    },
    "review_adjudication": {
      "type": ["string", "null"],
      "enum": ["not_needed", "third_blinded_expert", null]
    },
    "duration_minutes": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "automated_score": {
      "type": ["number", "null"]
    },
    "expert_review": {
      "type": ["string", "null"],
      "enum": ["pass", "partial", "fail", "no", null]
    },
    "missing_reason": {
      "type": ["string", "null"],
      "enum": ["withdrawn", "technical_failure", "review_unavailable", null]
    },
    "deviation_id": {
      "type": ["string", "null"]
    },
    "transfer_outcome": {
      "type": ["string", "null"],
      "enum": ["observed", "not_observed", null]
    }
  }
}
