{
  "contract_id": "adapter-capabilities.v0",
  "contract_version": "adapter-capability-contract-v0",
  "source_authority": "docs/north-star/agent-operator-score-ssot-v1.0.md#9.2",
  "redaction_policy": {
    "source_clause": "각 adapter는 허용된 source class만 사용해 capability를 선언하며 raw secret과 hidden reasoning은 어떤 source에서도 저장하지 않는다.",
    "never_stored": [
      "raw_secret",
      "hidden_reasoning"
    ]
  },
  "status_definitions": [
    {
      "status": "REQUIRED",
      "ordinal": 1,
      "source_clause": "REQUIRED: scored run에 반드시 필요. 누락 시 관련 metric 또는 전체 점수 차단",
      "definition": "Required for a scored run; its absence blocks the related metric or the whole score."
    },
    {
      "status": "CONDITIONAL",
      "ordinal": 2,
      "source_clause": "CONDITIONAL: 해당 기능을 사용했거나 scenario가 opportunity를 부여한 경우 필수",
      "definition": "Required when the capability was used or the scenario granted the opportunity."
    },
    {
      "status": "DERIVED",
      "ordinal": 3,
      "source_clause": "DERIVED: workspace·runner·artifact에서 결정론적으로 재구성 가능",
      "definition": "Deterministically reconstructable from the workspace, the runner or an artifact."
    },
    {
      "status": "BEST_EFFORT",
      "ordinal": 4,
      "source_clause": "BEST_EFFORT: 있으면 진단에 사용하되 누락을 사용자 실패로 처리하지 않음",
      "definition": "Used for diagnosis when present; its absence is never treated as operator failure."
    },
    {
      "status": "UNAVAILABLE",
      "ordinal": 5,
      "source_clause": "UNAVAILABLE: adapter가 관찰할 수 없음. 관련 metric은 NOT OBSERVED",
      "definition": "The adapter cannot observe it; the related metric is NOT OBSERVED."
    }
  ],
