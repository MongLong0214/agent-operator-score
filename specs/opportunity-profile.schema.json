{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-operator-score.dev/specs/opportunity-profile.schema.v0.json",
  "title": "opportunity-profile",
  "description": "Declared Opportunity Profile: condition record and comparison-restriction contract. It does not statistically remove environment effects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "suite",
    "family",
    "form_version",
    "language",
    "runtime",
    "adapter_version",
    "model_id",
    "model_revision",
    "reasoning_settings",
    "harness_profile",
    "harness_digest",
    "skill_hook_mcp",
    "skill_hook_mcp_digest",
    "tool_surface",
    "permission_profile",
    "network_profile",
    "context_budget",
    "token_budget",
    "time_budget",
    "tool_call_budget",
    "intervention_policy",
    "repository_digest",
    "environment_digest"
  ],
  "properties": {
    "suite": { "type": "string", "minLength": 1 },
    "family": { "type": "string", "minLength": 1 },
    "form_version": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 1 },
    "runtime": { "type": "string", "minLength": 1 },
    "adapter_version": { "type": "string", "minLength": 1 },
    "model_id": { "type": "string", "minLength": 1 },
    "model_revision": { "type": ["string", "null"], "minLength": 1 },
    "reasoning_settings": { "type": "string", "minLength": 1 },
    "harness_profile": { "type": "string", "minLength": 1 },
    "harness_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "skill_hook_mcp": { "type": "string", "minLength": 1 },
    "skill_hook_mcp_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "tool_surface": { "type": "string", "minLength": 1 },
    "permission_profile": { "type": "string", "minLength": 1 },
    "network_profile": { "type": "string", "minLength": 1 },
    "context_budget": { "type": "string", "minLength": 1 },
    "token_budget": { "type": "string", "minLength": 1 },
    "time_budget": { "type": "string", "minLength": 1 },
    "tool_call_budget": { "type": "string", "minLength": 1 },
    "intervention_policy": { "type": "string", "minLength": 1 },
    "repository_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "environment_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
