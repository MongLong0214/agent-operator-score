{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aos.example/specs/sprint-ledger.schema.json",
  "title": "Seven-day one-lever sprint ledger",
  "description": "The accepted event shapes for a seven-day sprint. A baseline-scoped change is a valid request shape but must be refused by the ledger; only local changes are recorded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "input"
  ],
  "properties": {
    "operation": {
      "enum": [
        "create",
        "recordTreatment",
        "recordAdherence",
        "recordDeviation",
        "recordCost",
        "recordChange",
        "close"
      ]
    },
    "input": {}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "create"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "$ref": "#/$defs/create"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "recordTreatment"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "$ref": "#/$defs/treatment"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "recordAdherence"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "$ref": "#/$defs/adherence"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "recordDeviation"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "$ref": "#/$defs/deviation"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "recordCost"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "$ref": "#/$defs/cost"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "recordChange"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "$ref": "#/$defs/change"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "close"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "create": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline"
      ],
      "properties": {
        "baseline": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "levers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "levers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "adherence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "treatmentId",
        "day"
      ],
      "properties": {
        "treatmentId": {
          "type": "string",
          "minLength": 1
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        }
      }
    },
    "deviation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "day",
        "reason"
      ],
      "properties": {
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "day",
        "amount"
      ],
      "properties": {
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "amount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "change"
      ],
      "properties": {
        "scope": {
          "enum": [
            "local",
            "baseline"
          ]
        },
        "change": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
