{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-operator-score.local/specs/aos-snapshot.schema.json",
  "title": "AOS Snapshot ESTIMATE output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "estimate_band",
    "recommended_family",
    "next_command",
    "watermark",
    "limitations",
    "version"
  ],
  "properties": {
    "estimate_band": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^0-9]+$"
    },
    "recommended_family": {
      "type": "string",
      "enum": [
        "FAM-1 Intent & Contracting",
        "FAM-2 Context, RAG & Decoy",
        "FAM-3 Graph & Orchestration",
        "FAM-4 Loop, State & Continuity",
        "FAM-5 Verification & False Completion",
        "FAM-6 Recovery, Safety & Efficiency"
      ]
    },
    "next_command": {
      "type": "string",
      "minLength": 1
    },
    "watermark": {
      "const": "ESTIMATE"
    },
    "limitations": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    }
  }
}
