{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MongLong0214/agent-operator-score/schemas/aos-execution-plan.v1.schema.json",
  "title": "AOS v0.2.0 execution plan",
  "description": "The machine-readable execution contract for the v0.2.0 release. A coding agent reads this file, not the epic prose, to decide what it is allowed to start.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "release",
    "repository",
    "epic",
    "milestone",
    "milestone_title",
    "integration_branch",
    "body_marker",
    "epic_body_marker",
    "release_label",
    "excluded_issues",
    "phase_output_vocabulary",
    "gates",
    "issues"
  ],
  "properties": {
    "schema": {
      "const": "aos-execution-plan.v1"
    },
    "release": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "epic": {
      "type": "integer",
      "minimum": 1
    },
    "milestone": {
      "type": "integer",
      "minimum": 1
    },
    "milestone_title": {
      "type": "string",
      "minLength": 1
    },
    "integration_branch": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "body_marker": {
      "type": "string",
      "minLength": 1
    },
    "epic_body_marker": {
      "type": "string",
      "minLength": 1
    },
    "release_label": {
      "type": "string",
      "minLength": 1
    },
    "excluded_issues": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "uniqueItems": true
    },
    "phase_output_vocabulary": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "integer"
        }
      }
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/issue"
      }
    }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue",
        "kind",
        "status",
        "batch",
        "blocked_by",
        "blocks",
        "priority",
        "area",
        "release_critical",
        "owner_surfaces",
        "owned_paths",
        "evidence_bindings",
        "allowed_parallel_with",
        "phases",
        "close_evidence_required",
        "required_evidence_fields"
      ],
      "properties": {
        "issue": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "implementation",
            "epic",
            "governance",
            "audit",
            "release",
            "acceptance"
          ]
        },
        "status": {
          "enum": [
            "ready",
            "blocked",
            "in-progress",
            "done",
            "tracking"
          ]
        },
        "batch": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "blocked_by": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "uniqueItems": true
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "uniqueItems": true
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2"
          ]
        },
        "area": {
          "enum": [
            "security",
            "measurement",
            "review",
            "release",
            "repo",
            "ux"
          ]
        },
        "release_critical": {
          "type": "boolean"
        },
        "owner_surfaces": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "owned_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_parallel_with": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "uniqueItems": true
        },
        "phases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/phase"
          }
        },
        "close_evidence_required": {
          "type": "boolean"
        },
        "required_evidence_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          }
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "blocked_by",
        "allowed_outputs",
        "code_integration_allowed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "status": {
          "enum": [
            "ready",
            "blocked",
            "in-progress",
            "done"
          ]
        },
        "blocked_by": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "uniqueItems": true
        },
        "allowed_outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "code_integration_allowed": {
          "type": "boolean"
        }
      }
    }
  }
}
