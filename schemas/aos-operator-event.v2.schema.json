{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aos.local/schemas/aos-operator-event.v2.schema.json",
  "title": "aos-operator-event.v2",
  "description": "One act an operator performed, recorded so that a reader can tell it from an act an agent performed. Every field is structural or a digest: the raw text an operator typed lives in the local restricted store and never in this record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "event_id",
    "run_id",
    "producer",
    "source",
    "authority",
    "provenance",
    "confidence",
    "decision_type",
    "construct_cell_id",
    "opportunity_id",
    "challenge_digest",
    "value_digest",
    "named_evidence_ids",
    "reported_confidence",
    "state_revision",
    "session_binding",
    "created_at"
  ],
  "properties": {
    "schema_id": { "const": "aos-operator-event.v2" },
    "event_id": { "type": "string", "pattern": "^operator-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "producer": { "const": "operator" },
    "source": { "enum": ["interactive-tty", "trusted-local-ui", "operator-file", "agent-relay"] },
    "authority": { "enum": ["DIRECT_LOCAL", "LOCAL_OWNER_RELAY", "ADVANCED_FILE"] },
    "provenance": { "enum": ["DIRECT", "RELAY_ATTESTED", "FILE_ATTESTED"] },
    "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] },
    "decision_type": {
      "enum": [
        "spec.goal",
        "constraint.add",
        "context.include",
        "context.exclude",
        "context.inspect",
        "context.request-metadata",
        "route.assign",
        "parallelism.choose",
        "verification.choose",
        "budget.set",
        "plan.approve",
        "plan.edit",
        "checkpoint.observe",
        "intervention.decide",
        "initial.judgment",
        "advice.response"
      ]
    },
    "construct_cell_id": { "type": "string", "pattern": "^C[1-9][0-9]?\\.[A-Z]{2}\\.[0-9]{2}$" },
    "opportunity_id": { "type": "string", "pattern": "^opp-[A-Za-z0-9][A-Za-z0-9._-]{0,62}$" },
    "challenge_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "value_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "named_evidence_ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "reported_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "state_revision": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "session_binding": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$" },
    "candidate_source": {
      "description": "D2 only. What the operator was deciding about, as structure: no source text and no excerpt.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "authority_class", "version", "untrusted_content", "size_bytes"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "authority_class": { "enum": ["AUTHORITATIVE", "SUPPORTING", "UNVERIFIED", "UNTRUSTED"] },
        "version": { "type": ["string", "null"], "maxLength": 128 },
        "untrusted_content": { "type": "boolean" },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 1099511627776 }
      }
    },
    "proactive_delegation": {
      "description": "Reliance only. Whether the operator chose to delegate this opportunity before seeing any advice, as the decision itself and never as a count of anything.",
      "enum": ["DELEGATE", "DECIDE_ALONE"]
    },
    "declared_route": {
      "description": "D3 only. The route the operator assigned, as agent ids in the order they were assigned. What actually ran is Outcome evidence and is never written here.",
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "relay_attestation": {
      "description": "agent-relay only. The relay protocol is #576; this record carries the attestation it produced and nothing about how it was produced.",
      "type": "object",
      "additionalProperties": false,
      "required": ["relay_id", "owner_challenge_digest", "attested_at"],
      "properties": {
        "relay_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "owner_challenge_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "attested_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$" }
      }
    },
    "file_provenance": {
      "description": "operator-file only. Which file this decision was read out of, by digest, and who attested that it was the operator's.",
      "type": "object",
      "additionalProperties": false,
      "required": ["path_digest", "file_digest", "attested_by", "attested_at"],
      "properties": {
        "path_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "file_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "attested_by": { "enum": ["local-owner"] },
        "attested_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$" }
      }
    }
  }
}
